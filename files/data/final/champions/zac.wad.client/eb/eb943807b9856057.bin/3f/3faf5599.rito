        0x88e125fe: string = "game_character_tips_RebirthEgg"
        0x87e1246b: string = "In general, Caster characters do well with items that have +Mana Points, +Mana Regeneration, +Spell Damage, and +Movement Speed. Caster characters can often benefit from Legendary items with activatable abilities."
        0x8d39bde6: string = "game_character_displayname_AniviaEgg"
